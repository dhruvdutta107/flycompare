# Copy to .env (or set these in your host's dashboard). None are required for local development.
NODE_ENV=production
PORT=3000
# --- Database -------------------------------------------------------------------------------------------
# Supabase (PostgreSQL). Dashboard > your project > Connect > "Session pooler" > copy YOUR URI (the host below is an
# example - use the exact one shown) and put your
# database password in place of [YOUR-PASSWORD]. Keep this secret: never commit .env or put it in front-end code.
DATABASE_URL=postgresql://postgres.zhoiquuerkmemljafaev:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Optional: path to Supabase's CA certificate (Database settings > SSL) to also verify the server certificate.
# DATABASE_CA_CERT=./supabase/prod-ca-2021.crt
# Optional: set to false to skip running supabase/schema.sql on start-up.
# DATABASE_AUTO_MIGRATE=true
# Without DATABASE_URL the app uses a local SQLite file instead (handy offline):
# DATABASE_PATH=./data/flycompare.db
# Set to 1 when running behind a proxy / load balancer (Render, Railway, Fly, Nginx) so HTTPS cookies and rate limits work.
TRUST_PROXY=1
# Optional: your public URL, used at build time to emit sitemap.xml.
SITE_URL=https://your-app.example.com
# Optional: Claude API key for the AI customer-service chat (falls back to a built-in rule-based assistant without it).
ANTHROPIC_API_KEY=
# Optional: model used by the assistant.
AI_MODEL=claude-haiku-5-5
